POSTGRES_PASSWORD=
# openssl rand -base64 32 — seals webhook secrets and TOTP seeds. Losing it invalidates them.
PITWALL_SECRET_KEY=
PITWALL_CONSOLE_URL=https://pitwall.example.com
PITWALL_INBOX_EMAIL=
PITWALL_REQUIRE_TOTP=true
# First admin, used only while the team is empty. Remove after the first sign-in.
PITWALL_ADMIN_EMAIL=
PITWALL_ADMIN_PASSWORD=
# Release notes (Claude Haiku 5.5)
ANTHROPIC_API_KEY=
# fs (volume) or s3 (S3 / Cloudflare R2 / MinIO — a private bucket)
STORAGE_PROVIDER=fs
STORAGE_BUCKET=
STORAGE_SERVICE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Hosts on which /v1/staff answers (the console calls the API as http://api:8080). Default: api.
# PITWALL_STAFF_HOSTS=api

# Caddy (only with --profile caddy): the two hostnames it serves and gets certificates for.
# The products' backends call PITWALL_API_DOMAIN; the team opens PITWALL_CONSOLE_DOMAIN, which must sit
# behind Cloudflare Access or Tailscale.
PITWALL_API_DOMAIN=api.example.com
PITWALL_CONSOLE_DOMAIN=pitwall.example.com
