# /opt/backups/backups.env, com chmod 600. Guia: docs/operacao/backup-bancos.md
# Sem aspas nem espaços em volta do "=": este arquivo é lido também pelo docker --env-file.

# Chave pública do age (começa com age1). A privada fica só no gerenciador de senhas.
AGE_RECIPIENT=

# Bucket do R2 e o token dele.
R2_BUCKET=braatz-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_REGION=auto
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
RCLONE_CONFIG_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=

# URLs dos monitores do tipo Push no Kuma.
PUSH_RHFLEX=
PUSH_DATARUNNER=
PUSH_METRIFREE=
PUSH_PITWALL=
PUSH_RESTAURACAO=
