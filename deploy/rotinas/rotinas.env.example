# Copy to rotinas.env (chmod 600) beside executar-rotinas.sh. Never commit the copy.

# The console's address as this machine reaches it. On the same server: the loopback port,
# which does not go through Cloudflare Access.
PITWALL_URL=http://127.0.0.1:3200
# A personal token (Conta e equipe → Tokens pessoais) of the person the routines act as.
PITWALL_TOKEN=
# Long-lived Claude Code token: run `claude setup-token` once on any machine and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Where the agent works: a directory with the repositories it may read or change.
# ROUTINES_WORKDIR=/home/rotinas/repos
# Seconds before a routine is stopped. Default 1800.
# ROUTINE_TIMEOUT_SECONDS=1800
# What the agent may do without asking (claude -p flags). Default: read files and use the Pitwall MCP.
# A routine that opens pull requests also needs the shell, for git and gh:
# ROUTINE_CLAUDE_ARGS=--allowedTools mcp__pitwall,Read,Glob,Grep,Edit,Write,Bash(git:*),Bash(gh:*)
# Use a local build of the MCP instead of `npx -y pitwall-mcp`:
# PITWALL_MCP_BIN=/opt/pitwall/packages/mcp/dist/index.js
