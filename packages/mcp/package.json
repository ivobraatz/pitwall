{
  "name": "pitwall-mcp",
  "version": "0.4.0",
  "description": "MCP server and Atlas Agent Sync for Pitwall: Claude Code works the team's task board, reports to the Atlas, and syncs the repository's services into it (pitwall-atlas).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivobraatz/pitwall.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "kanban",
    "tasks",
    "pitwall"
  ],
  "homepage": "https://github.com/ivobraatz/pitwall#readme",
  "bugs": {
    "url": "https://github.com/ivobraatz/pitwall/issues"
  },
  "type": "module",
  "bin": {
    "pitwall-mcp": "dist/index.js",
    "pitwall-atlas": "dist/atlas-cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
